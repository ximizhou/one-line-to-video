# Copy to .env and fill in. Real .env is gitignored.

# --- Google Gemini (AI Studio API key) ---
# NOTE: rate limits track THIS key's billing tier, NOT your consumer Google AI
# Pro subscription. Leave blank to run in MOCK mode (deterministic, no API calls).
# Put your REAL key only in .env (gitignored) — NEVER in this committed template.
GEMINI_API_KEY=

# Models are config-driven (no code change to swap). Resolve exact IDs for your
# tier once with your key:
#   python -c "from google import genai; c=genai.Client(api_key='YOUR_KEY'); [print(m.name) for m in c.models.list()]"
# or copy them from the AI Studio model picker. Phase 3 recommendation:
#   text  -> best Gemini-3 text model (script + designer; ~2 calls/job)
#   image -> Nano Banana 2 (Gemini 3.1 Flash Image): 100 RPM / 1K RPD, vertical-friendly
GEMINI_TEXT_MODEL=gemini-3-flash-preview
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# Set true to bypass real API calls (deterministic local dev / tests).
# Auto-enabled when GEMINI_API_KEY is empty.
USE_MOCK_PROVIDERS=false

# --- Text LLM + research ---
# The app accepts the local environment variable `dsh` for DeepSeek. Never paste
# the key into this file or the browser; the UI only selects provider/model.
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
RESEARCH_ENABLED=true
RESEARCH_PROVIDER=bing_html
RESEARCH_MAX_RESULTS=6
STORYBOARD_SCENE_COUNT=10

# --- Video provider ---
# mock = local FFmpeg smoke test; h3_workbench = a configured MiniMax-H3 workbench endpoint.
VIDEO_PROVIDER=h3_workbench
VIDEO_MODEL=fl2va
VIDEO_BASE_URL=http://127.0.0.1:8090
VIDEO_GPU=2
# Comma-separated pool; shots are round-robin dispatched across the pool.
VIDEO_GPU_POOL=2,3
VIDEO_ASPECT_RATIO=9:16
VIDEO_CLIP_SECONDS=6.0
VIDEO_MAX_CONCURRENCY=2
# 0 = use every storyboard shot; for a first H3 demo 5-8 is much faster.
VIDEO_MAX_SHOTS=0
# H3 frame count and output tier. UHD gives the best available vertical resolution.
VIDEO_FRAMES=72
VIDEO_QUALITY=uhd
VIDEO_STEPS=8
VIDEO_TIMEOUT_SECONDS=900
VIDEO_POLL_INTERVAL_SECONDS=3
VIDEO_HTTP_TIMEOUT_SECONDS=60
VIDEO_INPUT_MODE=t2v
# Keep inline SeedVR2 off while H3 stays resident on both GPUs; it competes for VRAM.
VIDEO_ENHANCE=false
VIDEO_ENHANCE_MODEL=seedvr2
VIDEO_ENHANCE_SCALE=2
VIDEO_ENHANCE_TILE=128
VIDEO_ENHANCE_SHARPEN=0.0

# --- TTS provider ---
# none = video only; indextts = a configured IndexTTS workbench; gemini = cloud TTS.
TTS_PROVIDER=none
TTS_BASE_URL=http://127.0.0.1:8082
TTS_VOICE_ID=
TTS_HTTP_TIMEOUT_SECONDS=60

# --- Gemini TTS voiceover (Phase 3 — OFF by default) ---
# Flash-TTS is ~100 requests/day, so the whole narration is synthesized in ONE
# call per job. Flip on once you've set a real key.
ENABLE_TTS=false
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
TTS_VOICE=Kore

# --- Database ---
DATABASE_URL=postgresql+asyncpg://storyboard:storyboard@localhost:5432/storyboard

# --- Storage ---
ARTIFACT_ROOT=./artifacts_store

# --- Image generation: reliability + format + throughput (Phase 3) ---
# Re-rolls on empty/no-image responses (+ transient retries) before falling back
# to a seamless neighbor-fill. Eliminates the silent "degraded frame" gaps.
IMAGE_GEN_MAX_RETRIES=5
# Vertical 9:16 short-form, sent straight to the image model (no pillarbox bars).
IMAGE_ASPECT_RATIO=9:16
# Bounded concurrency: max image calls in flight at once.
IMAGE_MAX_CONCURRENCY=4
# Global RPM ceiling (shared token bucket over ALL image calls incl. re-rolls).
# Keep comfortably under your image model's RPM (Nano Banana 2 = 100).
IMAGE_RPM_LIMIT=60

# --- Frame scaling ---
# Seconds each frame is held -> frame count = round(duration / SECONDS_PER_FRAME).
# At 2.0: 30s -> 15 frames, 60s -> 30 frames.
SECONDS_PER_FRAME=2.0

# --- Motion (Phase 3 — Ken Burns) ---
# true: per-frame slow zoom + crossfades + fixed caption overlay (filmed feel).
# false: plain concat of stills with burned-in captions (no motion / no-ffmpeg-extras).
# NOTE: this is the LOCAL Ken Burns toggle — NOT the external motion engine below.
ENABLE_MOTION=true
CROSSFADE_SECONDS=0.4

# --- Motion engine (external storyboard_engine service — per-scene live-photo clips) ---
# DISTINCT from ENABLE_MOTION: this calls the separate engine (default :8090) to
# animate each frame (depth parallax / Veo). OFF by default -> pipeline unchanged.
MOTION_ENGINE_ENABLED=false
MOTION_ENGINE_URL=http://localhost:8090
# Splice engine clips into the final storyboard.mp4 (needs ENABLE_MOTION=true too).
# Per-scene fallback to the Ken Burns zoom when a clip is missing, so no regression.
MOTION_IN_FILM=true
MOTION_CLIP_SECONDS=4.0
MOTION_STAGE_BUDGET_SECONDS=1800
MOTION_POLL_INTERVAL_SECONDS=2.0
MOTION_HTTP_TIMEOUT_SECONDS=30
MOTION_MAX_CONCURRENCY=30

# --- Captions ---
# Optional path to a .ttf for nicer subtitles. Unset = Pillow's scalable default.
# CAPTION_FONT_PATH=app/assets/fonts/Inter-Bold.ttf

# Optional fixed seed for the image model (best-effort; reference image carries
# consistency). Uncomment to set an integer; leave unset for none.
# IMAGE_SEED=42

# --- Observability: per-stage status + log streaming ---
# Powers GET /storyboard/{id}/events (SSE), GET /{id}/logs, and the stages on
# GET /{id}. OFF -> the SSE endpoint 503s; pull endpoints still serve any rows.
ENABLE_LOG_STREAMING=true
# How often the SSE stream polls the DB for new logs/stage changes (seconds).
# Invisible latency for a minutes-long job; lower = snappier + more DB reads.
LOG_POLL_INTERVAL_SECONDS=0.75
# Bounded capture queue: on overflow the OLDEST line is dropped (a flood never
# OOMs/blocks a job) and the drop surfaces as a synthetic per-job log line.
LOG_QUEUE_MAX=10000
LOG_DRAIN_BATCH=200
# Minimum level the stdlib-logging bridge captures into job_logs.
LOG_CAPTURE_LEVEL=INFO

# --- Frontend integration: CORS ---
# Browser origins allowed to call this API (the Next.js frontend). Accepts a
# comma-separated list OR a JSON list. Must include the deployed frontend origin.
CORS_ORIGINS=http://localhost:3000

# --- Job retention (TTL) ---
# Keep a job + its artifacts this long AFTER CREATION, then GET -> 410 and the
# background sweeper deletes the DB rows + on-disk files. Drives the UI countdown.
JOB_TTL_SECONDS=3600
JOB_SWEEP_INTERVAL_SECONDS=300

# --- Abuse / cost guard (the create endpoint is public + un-authed) ---
# Per-IP rate limit on POST /storyboard (slowapi syntax). RATE_LIMIT_ENABLED=false
# disables it (tests set this). Empty RATE_LIMIT_CREATE also disables it.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_CREATE=5/minute;30/day
# Cloudflare Turnstile: verify a token from the create form. OFF by default so
# local/mock dev needs no key. Set BOTH to enable in production.
TURNSTILE_ENABLED=false
TURNSTILE_SECRET_KEY=

# --- QA: force failure states (mock mode only ever yields clean frames) ---
# Inject one degraded frame -> completed_with_warnings (test the warnings banner).
MOCK_FORCE_DEGRADED_FRAME=false
# Raise inside the named stage -> failed (test the failed + Resume UI). Empty = off.
MOCK_FORCE_STAGE_FAILURE=
